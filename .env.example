# Copy this file to .env and fill in values for your own machine.
DB_HOST=127.0.0.1
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=civic_fix
DB_PORT=3306

# Cloudinary keeps uploads available after Render restarts.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# Optional: needed for email verification and password reset emails.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Optional: needed for Google sign-in.
GOOGLE_CLIENT_ID=

# Optional settings.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# GEOCODER_URL defaults to the public Nominatim search endpoint.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
